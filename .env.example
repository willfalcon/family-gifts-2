# Copy to .env.local. `npx convex dev` writes CONVEX_DEPLOYMENT and VITE_CONVEX_URL
# for you the first time it runs — you add the other two.

# Written by `npx convex dev`:
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=https://your-deployment-123.convex.cloud

# Same subdomain as VITE_CONVEX_URL but the .site domain (Convex HTTP actions,
# where Better Auth's routes are mounted):
VITE_CONVEX_SITE_URL=https://your-deployment-123.convex.site

# Your app's own origin in dev:
VITE_SITE_URL=http://localhost:3000
