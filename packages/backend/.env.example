# Copy to .env.local in this directory. `npx convex dev` (run from here) writes
# CONVEX_DEPLOYMENT and VITE_CONVEX_URL for you the first time it runs — you add
# the rest.

# Written by `npx convex dev`:
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=https://your-deployment-123.convex.cloud

# Same subdomain as VITE_CONVEX_URL but the .site domain (Convex HTTP actions,
# where Better Auth's routes are mounted):
VITE_CONVEX_SITE_URL=https://your-deployment-123.convex.site

# Your web app's own origin in dev:
VITE_SITE_URL=http://localhost:3000

# Set on the deployment with `npx convex env set RESEND_API_KEY ...` for prod;
# kept here too since local actions read it from this file during `convex dev`.
RESEND_API_KEY=
FROM_EMAIL_ADDRESS=

# Dev deployment only — never set this on prod. Expo Go ignores the app's own
# URL scheme and reports its own exp:// dev-server URL as the request origin,
# so convex/auth.ts additionally trusts that pattern when this is "true".
# Set with: npx convex env set ALLOW_EXPO_GO_DEV_ORIGIN true
ALLOW_EXPO_GO_DEV_ORIGIN=
